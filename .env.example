APP_NAME=agri-api
APP_ENV=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
CLIENT_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=agri
DB_PASSWORD=agri123
DB_NAME=agri_db
DB_SSLMODE=disable

POSTGRES_USER=agri
POSTGRES_PASSWORD=agri123
POSTGRES_DB=agri_db

# Administratorul creat la prima pornire, daca instalarea nu are niciun admin.
# Parola e provizorie: la prima autentificare aplicatia cere schimbarea ei.
ADMIN_EMAIL=admin@agri-manager.local
ADMIN_PASSWORD=schimba-ma-acum

JWT_SECRET=super-secret-key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

LOG_LEVEL=debug

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Cache Redis pentru rutele GET; TTL implicit (ex: 1m, 5m)
CACHE_ENABLED=true
CACHE_TTL=5m

# E-mail (SMTP). Testează setările cu: go run ./cmd/sendmail -to adresa@exemplu.ro
# - local, Mailpit (docker compose; mesajele se văd pe http://localhost:8025):
#     SMTP_HOST=localhost  SMTP_PORT=1025  fără user/parolă
# - Mailtrap Email Testing (sandbox: mesajele rămân în inbox-ul Mailtrap, nu ajung la destinatar):
#     SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525  SMTP_USER/SMTP_PASSWORD din inbox → SMTP Settings
# - Mailtrap Email Sending (livrare reală; domeniul expeditorului trebuie verificat în Mailtrap,
#   sau domeniul demo Mailtrap, care trimite doar către adresa contului tău Mailtrap):
#     SMTP_HOST=live.smtp.mailtrap.io  SMTP_PORT=587  SMTP_USER=api  SMTP_PASSWORD=<API token>
# SMTP_FROM acceptă și un nume afișat: AgriERP <noreply@domeniul-tau.ro>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@agri-manager.local

PUBLIC_URL=http://localhost:8080
OPENWEATHER_API_KEY=your_openweathermap_api_key

MAILTRAP_TOKEN=your_mailtrap_token

# Interval de verificare pentru depasirea timpului estimat de lucru la operatiunile pe teren (ex: 30s, 1m, 5m)
FIELD_OPERATION_OVERDUE_CHECK_INTERVAL=10m

# Interval de salvare a observatiilor meteo pentru terenuri, pentru istoricul meteo din rapoarte (ex: 30m, 1h; 0 dezactiveaza)
WEATHER_SNAPSHOT_INTERVAL=1h

# Token de analiză SonarQube (generat cu: make sonar-token)
SONAR_TOKEN=

# ngrok (make tunnel): domeniul static gratuit din dashboard.ngrok.com → Domains, ex.
# exemplu-ceva.ngrok-free.app. Pune-l și în CLIENT_ORIGIN (https://...), ca linkurile din
# e-mailuri (confirmare, resetare parolă) să ducă la tunel.
NGROK_DOMAIN=
